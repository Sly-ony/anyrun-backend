// ============================================================================
// Anyrun — Prisma Schema (Supabase / PostgreSQL)
// ============================================================================
// Notes on modeling choices (Updated for PostgreSQL):
// - Shifted identity identifiers to UUID to cleanly interoperate with Supabase Auth.
// - MongoDB composite types (`Location`, `RFQLineItem`, `QuotationLineItem`) 
//   have been converted into relational models, as PostgreSQL handles relationships natively.
// - `AccountProfile.roles` remains an array since PostgreSQL supports scalar enum arrays natively.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Note: For Prisma v7+, do not add your database 'url' here. 
  // Keep it in your `prisma.config.ts` for migration tasks.
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum AccountType {
  INDIVIDUAL_CUSTOMER
  RUNNER
  BUSINESS_BUYER
  BUSINESS_SUPPLIER
  CLEANING_PROVIDER
}

enum AccountKind {
  INDIVIDUAL
  BUSINESS
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
  SUPPORT
  DEVELOPER
}

enum VerificationType {
  BUSINESS
  JOB_CATEGORY
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ErrandStatus {
  OPEN
  ACCEPTED
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
}

enum RFQStatus {
  OPEN
  AWARDED
  CLOSED
}

enum QuotationStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum OrderSourceType {
  ERRAND
  RFQ_QUOTATION
  CATALOG_PURCHASE
  CLEANING_BOOKING
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryStatus {
  REQUESTED
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum CleaningServiceScope {
  DOMESTIC
  COMMERCIAL
}

enum CleaningBookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  NEW_ERRAND_REQUEST
  NEW_RFQ
  QUOTATION_RECEIVED
  QUOTATION_ACCEPTED
  ORDER_PAID
  DELIVERY_UPDATE
  CLEANING_BOOKING_UPDATE
  VERIFICATION_UPDATE
  DISPUTE_UPDATE
  ACCOUNT_SUSPENDED
  GENERAL
}

enum PaymentSourceType {
  ORDER
  DELIVERY_JOB
  CLEANING_BOOKING
}

// ----------------------------------------------------------------------------
// Relational Models (Converted from MongoDB Embedded Types)
// ----------------------------------------------------------------------------

model Location {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  country          String
  state            String
  city             String
  area             String?
  postalCode       String?
  latitude         Float?
  longitude        Float?
  
  // Relationship back to AccountProfile (since it represents service regions)
  accountProfileId String?         @db.Uuid
  accountProfile   AccountProfile? @relation(fields: [accountProfileId], references: [id])
}

model RFQLineItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId      String   // client-generated id to let quotations reference this line
  name        String
  quantity    Int
  notes       String?
  
  // This model will need a relation setup to your main RFQ model later, e.g.:
  // rfqId    String   @db.Uuid
  // rfq      RFQ      @relation(fields: [rfqId], references: [id])
}

model QuotationLineItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rfqItemId   String?  // References RFQLineItem.itemId when quoting per line
  name        String
  price       Float
  notes       String?
  available   Boolean  @default(true)

  // This model will need a relation setup to your main Quotation model later, e.g.:
  // quotationId String   @db.Uuid
  // quotation   Quotation @relation(fields: [quotationId], references: [id])
}

// ----------------------------------------------------------------------------
// Core Identity
// ----------------------------------------------------------------------------

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique
  phone         String?  @unique
  passwordHash  String? 
  oauthProvider String?
  oauthId       String?
  name          String
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accountProfile AccountProfile?
}

model AccountProfile {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String        @unique @db.Uuid
  user             User          @relation(fields: [userId], references: [id])
  roles            AccountType[]
  accountKind      AccountKind   
  businessName     String? 
  serviceRegions   Location[]    // 1-to-many relationship instead of array of objects
  isActive         Boolean       @default(true) 
  adminRole        AdminRole? 
  
  // Array of primitive strings (UUIDs) representing checked job categories
  jobCategoryIds   String[]      
  
  suspensionReason String? 
  suspendedAt      DateTime?
  suspendedBy      String?       @db.Uuid 
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Errand flow
  errandRequestsPosted   ErrandRequest[] @relation("ErrandCustomer")
  errandRequestsAccepted ErrandRequest[] @relation("ErrandRunner")

  // RFQ / procurement flow
  rfqsPosted          RFQ[]        @relation("RFQBuyer")
  quotationsSubmitted Quotation[]  @relation("QuotationSupplier")

  // Catalog
  catalogItems CatalogItem[] @relation("CatalogSupplier")

  // Cleaning
  cleaningBookingsAsCustomer CleaningBooking[] @relation("CleaningCustomer")
  cleaningBookingsAsProvider CleaningBooking[] @relation("CleaningProvider")

  // Money
  ordersAsPayer OrderTx[] @relation("OrderPayer")
  ordersAsPayee OrderTx[] @relation("OrderPayee")

  // Delivery
  deliveryJobsAssigned DeliveryJob[] @relation("DeliveryAssignee")

  notifications Notification[] @relation("NotificationRecipient")

  // Verifications
  verifications Verification[] @relation("AccountVerifications")
}

// ----------------------------------------------------------------------------
// Job categories + verification
// ----------------------------------------------------------------------------

model JobCategory {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String   @unique
  requiresVerification Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// Placeholder Stubs for missing references (To ensure compilation safety)
// ----------------------------------------------------------------------------
model ErrandRequest {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String         @db.Uuid
  customer    AccountProfile @relation("ErrandCustomer", fields: [customerId], references: [id])
  runnerId    String?        @db.Uuid
  runner      AccountProfile? @relation("ErrandRunner", fields: [runnerId], references: [id])
}

model RFQ {
  id      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerId String         @db.Uuid
  buyer   AccountProfile @relation("RFQBuyer", fields: [buyerId], references: [id])
}

model Quotation {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId String         @db.Uuid
  supplier   AccountProfile @relation("QuotationSupplier", fields: [supplierId], references: [id])
}

model CatalogItem {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId String         @db.Uuid
  supplier   AccountProfile @relation("CatalogSupplier", fields: [supplierId], references: [id])
}

model CleaningBooking {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String         @db.Uuid
  customer   AccountProfile @relation("CleaningCustomer", fields: [customerId], references: [id])
  providerId String         @db.Uuid
  provider   AccountProfile @relation("CleaningProvider", fields: [providerId], references: [id])
}

model OrderTx {
  id      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payerId String         @db.Uuid
  payer   AccountProfile @relation("OrderPayer", fields: [payerId], references: [id])
  payeeId String         @db.Uuid
  payee   AccountProfile @relation("OrderPayee", fields: [payeeId], references: [id])
}

model DeliveryJob {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assigneeId String         @db.Uuid
  assignee   AccountProfile @relation("DeliveryAssignee", fields: [assigneeId], references: [id])
}

model Notification {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String         @db.Uuid
  recipient   AccountProfile @relation("NotificationRecipient", fields: [recipientId], references: [id])
}

model Verification {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String         @db.Uuid
  account   AccountProfile @relation("AccountVerifications", fields: [accountId], references: [id])
}
